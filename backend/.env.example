# =========================================
# BongCloud Chess Environment Configuration
# =========================================

# -----------------------------------------
# Application
# -----------------------------------------
APP_ENV=development
APP_PORT=8080
APP_NAME=bongcloud-chess
APP_VERSION=0.0.1

# -----------------------------------------
# MongoDB
# -----------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=bongcloud_chess
MONGO_TIMEOUT_SECONDS=10
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=5

# -----------------------------------------
# Redis
# -----------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_DIAL_TIMEOUT_SECONDS=5
REDIS_READ_TIMEOUT_SECONDS=3
REDIS_WRITE_TIMEOUT_SECONDS=3

# -----------------------------------------
# WebSocket
# -----------------------------------------
WS_READ_BUFFER_SIZE=1024
WS_WRITE_BUFFER_SIZE=1024
WS_HANDSHAKE_TIMEOUT_SECONDS=10
WS_PING_INTERVAL_SECONDS=30
WS_PONG_WAIT_SECONDS=60

# -----------------------------------------
# HTTP Server
# -----------------------------------------
SERVER_READ_TIMEOUT_SECONDS=15
SERVER_WRITE_TIMEOUT_SECONDS=15
SERVER_IDLE_TIMEOUT_SECONDS=60
SERVER_SHUTDOWN_TIMEOUT_SECONDS=30

# -----------------------------------------
# Logging
# -----------------------------------------
LOG_LEVEL=debug
LOG_ENCODING=console